    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-vue": "6.0.9",
    "sharp": "^0.34.0",
    "tsx": "^4.20.0",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "^4.0.0",
    "vue-tsc": "3.3.12"
