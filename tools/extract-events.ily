% Offline audit: observe LilyPond's notation events, never MIDI output.
#(define audit-port (open-output-file "events.scm"))
#(define (audit-tick context)
  (ly:moment-main (ly:moment-mul (ly:context-current-moment context) (ly:make-moment 3840))))
#(define (audit-write context kind values)
  (write (append (list kind (ly:context-id (ly:context-find context 'Staff)) (audit-tick context)) values) audit-port)
  (newline audit-port) (force-output audit-port))
#(define (audit-duration event)
  (let ((d (ly:event-property event 'duration)))
    (list (ly:moment-main (ly:moment-mul (ly:duration-length d) (ly:make-moment 3840)))
      (ly:duration-log d) (ly:duration-dot-count d))))
#(define (audit-engraver context)
  (make-engraver
    (listeners
      ((note-event engraver event)
        (let ((p (ly:event-property event 'pitch)))
          (audit-write context "note" (append (audit-duration event)
            (list (+ 60 (ly:pitch-semitones p)) (ly:pitch-notename p) (ly:pitch-octave p) (ly:pitch-alteration p)
              (string-join (map number->string (filter number? (map (lambda (a) (ly:event-property a 'digit)) (ly:event-property event 'articulations)))) ","))))))
      ((rest-event engraver event) (audit-write context "rest" (audit-duration event)))
      ((tie-event engraver event) (audit-write context "tie" '()))
      ((slur-event engraver event) (audit-write context "slur" (list (ly:event-property event 'span-direction))))
      ((articulation-event engraver event) (audit-write context "articulation" (list (ly:event-property event 'articulation-type))))
      ((absolute-dynamic-event engraver event) (audit-write context "dynamic" (list (ly:event-property event 'text))))
      ((crescendo-event engraver event) (audit-write context "crescendo" (list (ly:event-property event 'span-direction) (ly:event-property event 'span-type 'hairpin) (ly:event-property event 'span-text ""))))
      ((decrescendo-event engraver event) (audit-write context "decrescendo" (list (ly:event-property event 'span-direction) (ly:event-property event 'span-type 'hairpin) (ly:event-property event 'span-text ""))))
      ((text-script-event engraver event) (audit-write context "text" (list (markup->string (ly:event-property event 'text)))))
      ((fingering-event engraver event) (audit-write context "finger" (list (ly:event-property event 'digit)))))))
